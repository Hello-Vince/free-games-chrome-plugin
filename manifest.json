{
  "manifest_version": 3,
  "name": "Free Games Tracker",
  "version": "0.1.0",
  "description": "Find active game giveaways and track which offers you have already visited.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.gamerpower.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Free Games Tracker",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/muted-16.png",
      "32": "icons/muted-32.png",
      "48": "icons/muted-48.png",
      "128": "icons/muted-128.png"
    }
  },
  "icons": {
    "16": "icons/bright-16.png",
    "32": "icons/bright-32.png",
    "48": "icons/bright-48.png",
    "128": "icons/bright-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' https://www.gamerpower.com data:;"
  }
}
